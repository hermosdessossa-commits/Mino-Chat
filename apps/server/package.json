{
  "name": "@mino-chat/server",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "db:generate": "prisma generate --schema=../../packages/db/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=../../packages/db/prisma/schema.prisma",
    "db:studio": "prisma studio --schema=../../packages/db/prisma/schema.prisma",
    "db:seed": "tsx ../../packages/db/prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@mino-chat/db": "workspace:*",
    "@mino-chat/shared": "workspace:*",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.12.5",
    "fastify-zod": "^1.4.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "minio": "^8.0.3",
    "nodemailer": "^10.0.12",
    "socket.io": "^4.7.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.12.0",
    "@types/nodemailer": "^6.4.14",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.10.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
