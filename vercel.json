{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "fluid": true,
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "vite",
      "installCommand": "pnpm install --frozen-lockfile",
      "buildCommand": "pnpm --filter @mino-chat/shared build && pnpm --filter @mino-chat/web build",
      "outputDirectory": "dist",
      "rewrites": [
        { "source": "/(.*)", "destination": "/index.html" }
      ]
    },
    "api": {
      "root": "apps/server",
      "framework": "fastify",
      "entrypoint": "src/index.ts",
      "installCommand": "pnpm install --frozen-lockfile",
      "buildCommand": "pnpm --filter @mino-chat/db db:generate && pnpm --filter @mino-chat/server... build && if [ \"$VERCEL_ENV\" = \"production\" ]; then pnpm --filter @mino-chat/db db:migrate:deploy; fi",
      "functions": {
        "src/index.ts": {
          "maxDuration": 300,
          "regions": ["fra1"]
        }
      }
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/auth/(.*)", "destination": { "service": "api" } },
    { "source": "/health", "destination": { "service": "api" } },
    { "source": "/socket.io/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
