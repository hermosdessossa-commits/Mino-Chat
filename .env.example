# =============================================================================
# Mino-Chat - Environment Variables Template
# Copy to .env and fill in values
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# -----------------------------------------------------------------------------
# Database (Supabase / PostgreSQL)
# -----------------------------------------------------------------------------
# Transaction pooler (port 6543) - for application runtime
DATABASE_URL=postgresql://user:password@host:6543/postgres?sslmode=require&pgbouncer=true
# Session pooler (port 5432) - for migrations
DIRECT_URL=postgresql://user:password@host:5432/postgres?sslmode=require

# -----------------------------------------------------------------------------
# Authentication (JWT)
# -----------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-access-token-key-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-jwt-refresh-token-key-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_REFRESH_EXPIRY_REMEMBER=30d

# -----------------------------------------------------------------------------
# Redis (Socket.io adapter, rate limiting, sessions)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Storage (S3-compatible: MinIO dev, R2/Supabase Storage prod)
# -----------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=mino-chat
S3_REGION=auto
S3_PUBLIC_URL=http://localhost:9000/mino-chat

# -----------------------------------------------------------------------------
# Email (Resend recommended for Render)
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=Mino-Chat <noreply@mino.chat>
EMAIL_REPLY_TO=support@mino.chat

# -----------------------------------------------------------------------------
# Frontend (Vite)
# -----------------------------------------------------------------------------
VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000
VITE_APP_NAME=Mino-Chat

# -----------------------------------------------------------------------------
# Optional: Monitoring & Error Tracking
# -----------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=